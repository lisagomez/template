# Parámetros de instalación de LA CASA para erp/instalacion/instalar.sh.
# NO se entrega (erp/casa/). Sin secretos: las contraseñas y ERP_DB_URL nunca van aquí.
# Producción ya está instalada y es idéntica a lo que produce el instalador (ESTADO-PRODUCCION.md);
# esto sirve para recrear la base de la casa desde cero o para un staging propio.
ERP_TENANT_ID=2de8835a-439c-461a-990c-a2b95d29f3a4
# Nombre comercial: lo fija el laboratorio. Producción hoy NO tiene comentario de identidad en
# el esquema; ponérselo es una escritura en producción (gate humano).
ERP_MARCA=
ERP_PUENTE_POSTGRES=1
ERP_LOGIN_EJECUTOR=cli_fin
ERP_LOGIN_LECTOR=erp_lector
