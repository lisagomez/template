{
  "name": "saas-factory-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepara:gate": "node scripts/prepara-gate.mjs",
    "pretypecheck": "node scripts/prepara-gate.mjs",
    "typecheck": "tsc --noEmit",
    "verify:gobernanza": "node scripts/verifica-gobernanza.mjs",
    "verifica:specs": "node scripts/verifica-specs.mjs",
    "regresion": "node scripts/regresion-skills.mjs",
    "audita:fugas": "node scripts/audita-fugas.mjs",
    "audita:secretos": "node scripts/audita-secretos.mjs",
    "configura:deploy": "node scripts/configura-deploy.mjs",
    "empaqueta": "node scripts/empaqueta-herramienta.mjs",
    "mide:contexto": "node scripts/mide-contexto.mjs",
    "sincroniza:gemini": "node scripts/sincroniza-gemini.mjs",
    "mide:mcp": "node scripts/mide-mcp.mjs",
    "audita:imprenta": "node scripts/audita-imprenta.mjs",
    "prueba:imprenta": "node scripts/prueba-imprenta.mjs",
    "verifica:routing": "node scripts/verifica-routing.mjs",
    "prueba:contabilidad": "node scripts/prueba-contabilidad.ts",
    "vigila:versiones": "node scripts/vigila-versiones.mjs",
    "vigila:hermes": "node scripts/verifica-hermes.mjs",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run verify:gobernanza && npm run verifica:specs && npm run regresion && npm run audita:secretos && npm run mide:contexto && npm run verifica:routing && npm run prueba:contabilidad && npm run prueba:imprenta && npm run audita:imprenta && node scripts/sello-validate.mjs --sella",
    "deploy:build": "docker compose --env-file .env.production build",
    "deploy:up": "docker compose --env-file .env.production up -d",
    "deploy:down": "docker compose --env-file .env.production down",
    "deploy:logs": "docker compose --env-file .env.production logs -f --tail=100",
    "deploy:ps": "docker compose --env-file .env.production ps",
    "predeploy": "node scripts/sello-validate.mjs --verifica || (npm run verify:gobernanza && npm run verifica:specs && npm run regresion && npm run audita:secretos && npm run mide:contexto && npm run verifica:routing && npm run prueba:contabilidad && npm run prueba:imprenta && npm run audita:imprenta)",
    "deploy": "npm run deploy:build && npm run deploy:up && npm run deploy:ps"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
