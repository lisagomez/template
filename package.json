{
  "name": "saas-factory-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/centro-de-mando/prepara-silero.ts",
    "dev": "next dev --turbopack",
    "prepara:silero": "node scripts/centro-de-mando/prepara-silero.ts",
    "dev:movil": "next dev --turbopack --experimental-https --hostname 0.0.0.0",
    "prebuild": "node scripts/prepara-gate.mjs && node scripts/centro-de-mando/prepara-silero.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepara:gate": "node scripts/prepara-gate.mjs",
    "pretypecheck": "node scripts/prepara-gate.mjs",
    "typecheck": "tsc --noEmit",
    "verify:gobernanza": "node scripts/verifica-gobernanza.mjs",
    "verifica:specs": "node scripts/verifica-specs.mjs",
    "verifica:gates": "node scripts/verifica-gates.mjs",
    "verifica:generados": "node scripts/verifica-generados.mjs",
    "prueba:tools": "node scripts/prueba-tools.mjs",
    "prueba:instancias": "node infra/cerebro-personal/prueba.mjs",
    "prueba:a2a": "node --test --test-skip-pattern=^SERVICIO: scripts/prueba-a2a.ts",
    "prueba:a2a:servicio": "node --test --test-name-pattern=^SERVICIO: scripts/prueba-a2a.ts",
    "prueba:analista": "node --test scripts/analista-producto/prueba-analista.ts",
    "prueba:buzon": "node --test scripts/buzon/prueba-*.mjs",
    "recorrido:buzon": "bash scripts/buzon/recorrido.sh",
    "prueba:migraciones": "node scripts/prueba-migraciones.mjs",
    "gates": "node scripts/verifica-gates.mjs --lista",
    "proyecta:gates": "node scripts/proyecta-gates.mjs",
    "verifica:inventario": "node scripts/inventario/detecta.mjs",
    "prueba:inventario": "node --test scripts/prueba-inventario.ts",
    "inventario:vista": "node scripts/inventario/vista.mjs",
    "inventario:exporta": "node scripts/inventario/exporta.mjs",
    "inventario:valida-erp": "node scripts/inventario/valida-erp.mjs",
    "erp:prueba": "bash erp/instalacion/prueba-efimera.sh",
    "erp:control": "bash erp/instalacion/control-reversion.sh",
    "verifica:marca-blanca": "node scripts/verifica-marca-blanca.mjs",
    "verifica:productos": "node scripts/verifica-productos.mjs",
    "verifica:enchufes": "node scripts/capa/verifica-enchufes.mjs",
    "revisa:readmes": "node scripts/revisa-readmes.mjs",
    "readme:no-perdida": "node scripts/no-perdida-readme.mjs",
    "regresion": "node scripts/regresion-skills.mjs",
    "audita:fugas": "node scripts/audita-fugas.mjs",
    "audita:secretos": "node scripts/audita-secretos.mjs",
    "configura:deploy": "node scripts/configura-deploy.mjs",
    "empaqueta": "node scripts/empaqueta-herramienta.mjs",
    "mide:contexto": "node scripts/mide-contexto.mjs",
    "sincroniza:gemini": "node scripts/sincroniza-gemini.mjs",
    "mide:mcp": "node scripts/mide-mcp.mjs",
    "audita:imprenta": "node scripts/audita-imprenta.mjs",
    "prueba:imprenta": "node scripts/prueba-imprenta.mjs",
    "verifica:routing": "node scripts/verifica-routing.mjs",
    "prueba:contabilidad": "node scripts/prueba-contabilidad.ts",
    "prueba:laboratorio": "node --test src/features/laboratorio-voz/pruebas/*.ts",
    "prueba:laboratorio-pymes": "node --test src/features/laboratorio-pymes/pruebas/*.ts",
    "prueba:laboratorio-sgi": "node --test src/features/laboratorio-sgi/pruebas/*.ts",
    "sgi:catalogo": "node scripts/sgi/catalogo.ts && node scripts/sgi/catalogo-sql.ts --verifica",
    "sgi:local:reinicia": "npx -y supabase@2.118.0 db reset --local && node scripts/sgi/siembra.ts && node scripts/sgi/entorno-local.ts",
    "sgi:rls": "node scripts/sgi/mide-aislamiento.ts",
    "sgi:agentes": "node scripts/sgi/corre-agentes.ts",
    "reel:laboratorio": "node scripts/reel/laboratorio.ts",
    "reel:marcas": "node scripts/reel/mide-marcas.ts public/laboratorio-pymes/reel/marcas.json",
    "reel:migraciones": "node scripts/reel/aplica-migraciones.mjs",
    "reel:rls": "node scripts/reel/mide-aislamiento.ts",
    "reel:retencion": "node scripts/reel/retencion.ts",
    "reel:tras-restaurar": "node scripts/reel/tras-restaurar.ts",
    "contenido:referencias": "node scripts/laboratorio-pymes/referencias.ts",
    "etiquetas:referencias": "node scripts/laboratorio-etiquetas/referencias.ts",
    "contenido:video": "node scripts/laboratorio-pymes/video.ts",
    "prueba:historial": "node --test src/features/historial/pruebas/*.ts",
    "vigila:versiones": "node scripts/vigila-versiones.mjs",
    "vigila:hermes": "node scripts/verifica-hermes.mjs",
    "validate": "node scripts/corre-gates.mjs validate",
    "deploy:build": "docker compose --env-file .env.production build",
    "deploy:up": "docker compose --env-file .env.production up -d",
    "deploy:down": "docker compose --env-file .env.production down",
    "deploy:logs": "docker compose --env-file .env.production logs -f --tail=100",
    "deploy:ps": "docker compose --env-file .env.production ps",
    "verifica:privado": "node scripts/verifica-privado.mjs",
    "predeploy": "node scripts/corre-gates.mjs predeploy",
    "deploy": "npm run deploy:build && npm run deploy:up && npm run deploy:ps",
    "verifica:trayectorias": "node scripts/trayectorias/verifica.mjs",
    "prueba:trayectorias": "node --test scripts/prueba-trayectorias.ts",
    "trayectorias:captura": "node scripts/trayectorias/captura-sesion.mjs",
    "trayectorias:ingesta": "node scripts/trayectorias/ingesta.mjs",
    "trayectorias:evalua": "node scripts/trayectorias/evalua.mjs",
    "trayectorias:informe": "node scripts/trayectorias/informe.mjs",
    "trayectorias:propuestas": "node scripts/trayectorias/propuestas.mjs",
    "prueba:ajustes": "node --test src/features/ajustes/pruebas/*.ts",
    "prueba:etiquetas": "npm --prefix tools/etiquetas-gs1 run prueba && node --test src/features/etiquetas/pruebas/*.ts && node --test src/features/laboratorio-etiquetas/pruebas/*.ts",
    "capturas:etiquetas": "node src/features/etiquetas/e2e/capturas.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "bwip-js": "4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.0.0",
    "onnxruntime-web": "1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "9.3.10",
    "sharp": "0.35.4",
    "tailwind-merge": "^2.6.1",
    "uqr": "0.1.3",
    "write-excel-file": "4.1.1",
    "zod": "^4.4.3",
    "zpl-renderer-js": "4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "js-yaml": "4.3.1",
    "playwright": "1.63.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "undici": "^7.16.0",
    "zxing-wasm": "^3.1.4"
  }
}
