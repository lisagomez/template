{
  "name": "@tu-scope/agora",
  "version": "0.1.0",
  "description": "Ágora: el núcleo del espacio de trabajo donde equipo, agentes internos y agentes de socios planean y ejecutan en un buzón y un tablero, con libro de costos por compromisos, aprobación de Finanzas, póliza propuesta para Contabilidad y una Puerta A2A cerrada. Núcleo sin React, Next ni Supabase; la base (Postgres con RLS forzada) impone las reglas.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base/pg": {
      "types": "./dist/base/pg.d.ts",
      "import": "./dist/base/pg.js"
    },
    "./base/pglite": {
      "types": "./dist/base/pglite.d.ts",
      "import": "./dist/base/pglite.js"
    },
    "./laboratorio": {
      "types": "./dist/laboratorio/index.d.ts",
      "import": "./dist/laboratorio/index.js"
    },
    "./fechas": {
      "types": "./dist/fechas.d.ts",
      "import": "./dist/fechas.js"
    }
  },
  "files": [
    "dist",
    "migraciones",
    "semillas",
    "config"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "preprueba": "npm run build",
    "prueba": "node --test --test-concurrency=1 pruebas/[a-z]*.ts",
    "sabotajes": "node evidencia/sabotajes.ts"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "0.5.8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  }
}
