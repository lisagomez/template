{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.79"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.7.0"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@0.4.0"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@0.11.0",
        "--project-ref=YOUR_SUPABASE_PROJECT_REF"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search@0.6.2"
      ],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY"
      }
    },
    "firecrawl-mcp@3.24.0": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp@3.24.0"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY"
      }
    },
    "n8n-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "MCP_MODE=stdio",
        "-e",
        "LOG_LEVEL=error",
        "-e",
        "DISABLE_CONSOLE_OUTPUT=true",
        "-e",
        "N8N_API_URL=YOUR_N8N_API_URL",
        "-e",
        "N8N_API_KEY=YOUR_N8N_API_KEY",
        "ghcr.io/czlonkowski/n8n-mcp:2.4.2"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ]
    },
    "_comment_google": "--- GOOGLE MCPs (Opcionales) --- Descomentar/agregar solo si el proyecto los necesita",
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@15.28.1",
        "mcp"
      ]
    },
    "_comment_google_workspace": "RETIRADO 2026-08-23: '@anthropic-ai/google-workspace-mcp' no existe en npm. El skill google-workspace usa el CLI 'gog', no un MCP. Si algun dia hay paquete real, se anade PINEADO."
  }
}
