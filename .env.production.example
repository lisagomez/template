# =============================================================================
# Produccion — VPS self-hosted (Hetzner u otro). Copiar a .env.production
# EN EL SERVIDOR y rellenar. .env.production esta en .gitignore: nunca se commitea.
#
# Despues de rellenarlo:  npm run configura:deploy -- --escribir
# Ese comando mide el servidor real, valida esto de abajo y añade el bloque de
# tamaño. No adivines los limites: el unico que sabe cuanta RAM hay es el servidor.
# =============================================================================

# --- Dominio y TLS (Caddy) ---
DOMAIN=tuapp.com
TLS_EMAIL=tu@email.com

# --- Supabase: publicas (se INLINEAN en build) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
NEXT_PUBLIC_SITE_URL=https://tuapp.com

# --- Secretos server-side (se leen en RUNTIME, nunca llegan al navegador) ---
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# --- Identidad de la imagen (Docker personalizado) ---
# Con esto la imagen deja de llamarse como el template y pasa a llamarse como TU app.
APP_NAME=saas-factory-app
APP_VERSION=latest

# --- Tamaño del stack ---
# NO se rellenan a mano: los escribe `npm run configura:deploy -- --escribir`
# midiendo vCPU y RAM reales. Si copias este bloque de otro servidor, mientes.
#   APP_CPUS=       limite de vCPU de la app
#   APP_MEM=        limite de RAM de la app (ej. 2048M)
#   CADDY_MEM=      limite de RAM de Caddy
#   CADDY_CPUS=     limite de vCPU de Caddy (menos en servidores de 1-2 nucleos)
#   NODE_HEAP_MB=   heap del build de Next.js — el pico de memoria del deploy
