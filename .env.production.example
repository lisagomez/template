# =============================================================================
# Produccion — VPS self-hosted (Hetzner u otro). Copiar a .env.production
# EN EL SERVIDOR y rellenar. .env.production esta en .gitignore: nunca se commitea.
#
# Despues de rellenarlo:  npm run configura:deploy -- --escribir
# Ese comando mide el servidor real, valida esto de abajo y añade el bloque de
# tamaño. No adivines los limites: el unico que sabe cuanta RAM hay es el servidor.
# =============================================================================

# --- Dominio y TLS (Caddy) ---
DOMAIN=tuapp.com
TLS_EMAIL=tu@email.com

# --- Supabase: publicas (se INLINEAN en build) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
NEXT_PUBLIC_SITE_URL=https://tuapp.com

# --- Secretos server-side (se leen en RUNTIME, nunca llegan al navegador) ---
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

# --- Identidad de la imagen (Docker personalizado) ---
# Con esto la imagen deja de llamarse como el template y pasa a llamarse como TU app.
APP_NAME=saas-factory-app
APP_VERSION=latest

# --- Extractor documental (perfiles ocr / ocr-gpu / hermes, spec 010) ---
# Clave que exige el puente A2A en la red interna (vacia = sin clave). La comparten app y
# puente-hermes. Exponer el puente FUERA de la red interna es gate humano (C3 + C4).
A2A_API_KEY=
# Configuracion de PROYECTO del OCR (clases, patrones, esquemas por clase). El ejemplo trae
# el expediente laboral mexicano; monta el tuyo y apunta aqui.
# OCR_PROYECTO=/extractor/servicio/proyecto-ejemplo.json
# La cola de vision: ninguno | compatible | mistral
#   compatible -> ocr-gpu (vLLM) u otro servidor con API compatible en OCR_RESPALDO_BASE
#   mistral    -> el documento SALE del perimetro. Exige OCR_DECISION_C4_ARCHIVO (decision
#                 firmada) y MISTRAL_API_KEY. Con datos de terceros, ninguna firma lo autoriza.
OCR_RESPALDO=ninguno
# OCR_GPU_MODELO=zai-org/GLM-OCR        # PINEADO (sin :latest). Obligatorio con --profile ocr-gpu
# OCR_RESPALDO_BASE=http://ocr-gpu:8000/v1
# OCR_DECISION_C4_ARCHIVO=/opt/app/decision-c4-mistral.md
# OCR_MISTRAL_MODELO=mistral-ocr-2505
MISTRAL_API_KEY=
# Carpeta de entrada que el puente de Hermes lee (solo lectura): los documentos que un agente
# puede pedir por nombre. Fuera del repo.
# OCR_ENTRADA=/opt/app/documentos-entrada
# Hermes (perfil hermes): su .env y su HOME con config.yaml (ver hermes/config.extractor.yaml)
# HERMES_ENV=/opt/hermes/.env
# HERMES_HOME=/opt/hermes/clientes/.hermes

# --- Tamaño del stack ---
# NO se rellenan a mano: los escribe `npm run configura:deploy -- --escribir`
# midiendo vCPU y RAM reales. Si copias este bloque de otro servidor, mientes.
#   APP_CPUS=       limite de vCPU de la app
#   APP_MEM=        limite de RAM de la app (ej. 2048M)
#   CADDY_MEM=      limite de RAM de Caddy
#   CADDY_CPUS=     limite de vCPU de Caddy (menos en servidores de 1-2 nucleos)
#   NODE_HEAP_MB=   heap del build de Next.js — el pico de memoria del deploy
#   OCR_GPU=        presente | ninguna — medido con nvidia-smi y el runtime de Docker
#   OCR_CPUS= OCR_MEM= OCR_EN_VUELO=   limites del servicio OCR, derivados de la maquina
